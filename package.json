{
  "name": "dnd35-character-sheet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:feats": "node scripts/validate-feats.mjs src/data/feats.json",
    "validate:skills": "node scripts/validate-skills.mjs src/data/skills.json",
    "ingest-rulebook": "node scripts/ingest-rulebook.mts",
    "merge-rulebook-classes": "node scripts/merge-rulebook-classes.mts",
    "guard:no-inline-styles": "bash -lc \"! grep -R --line-number -E 'style\\s*=\\s*\\{\\s*\\{' src || (echo 'Inline styles found; please extract to CSS' && exit 1)\"",
    "check": "npm run format:check && npm run lint && npm run guard:no-inline-styles",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.58.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.2",
    "csv-parse": "6.2.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "16.4.0",
    "playwright": "^1.61.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.2",
    "vite": "8.0.5",
    "vitest": "4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,css,md,json}": [
      "prettier --write"
    ]
  }
}
